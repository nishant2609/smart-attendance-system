<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SmartAttendance" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/deep_blue_mid</item>
        <item name="colorPrimaryVariant">@color/deep_blue_start</item>
        <item name="colorOnPrimary">@color/text_on_dark</item>
        <item name="colorSecondary">@color/accent_gold</item>
        <item name="colorOnSecondary">@color/deep_blue_mid</item>

        <!-- Status / nav bars -->
        <item name="android:statusBarColor">@color/deep_blue_start</item>
        <item name="android:navigationBarColor">@color/deep_blue_start</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Global font -->
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>

    <!-- Splash: shows gradient instantly, no white flash -->
    <style name="Theme.SmartAttendance.Splash" parent="Theme.SmartAttendance">
        <item name="android:windowBackground">@drawable/gradient_background</item>
        <item name="android:windowFullscreen">false</item>
    </style>

</resources>