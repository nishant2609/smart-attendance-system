<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartAttendance" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#3F51B5</item>
        <item name="colorPrimaryVariant">#1A237E</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#4CAF50</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">#1A237E</item>
    </style>

    <!-- Splash theme with blue background so no white flash -->
    <style name="Theme.SmartAttendance.Splash" parent="Theme.SmartAttendance">
        <item name="android:windowBackground">@drawable/gradient_background</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>