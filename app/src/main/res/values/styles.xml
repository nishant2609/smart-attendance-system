<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ════════════════════════════════════════
         CARD STYLES
         ════════════════════════════════════════ -->

    <style name="Card.Dashboard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="cardElevation">6dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="contentPadding">20dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Card.Stat" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_overlay</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="contentPadding">16dp</item>
        <item name="strokeColor">@color/surface_overlay_med</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Card.ListItem" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_white</item>
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="contentPaddingLeft">16dp</item>
        <item name="contentPaddingRight">16dp</item>
        <item name="contentPaddingTop">12dp</item>
        <item name="contentPaddingBottom">12dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ════════════════════════════════════════
         BUTTON STYLES
         ════════════════════════════════════════ -->

    <style name="Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/deep_blue_mid</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_btn_primary_blue</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Button.Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="strokeColor">@color/border_light</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- ════════════════════════════════════════
         FAB STYLES
         ════════════════════════════════════════ -->

    <style name="FAB.Primary" parent="Widget.MaterialComponents.ExtendedFloatingActionButton">
        <item name="backgroundTint">@color/accent_gold</item>
        <item name="android:textColor">@color/deep_blue_mid</item>
        <item name="iconTint">@color/deep_blue_mid</item>
        <item name="elevation">12dp</item>
    </style>

    <!-- ════════════════════════════════════════
         BOTTOM NAVIGATION STYLE
         Note: itemActiveIndicatorColor requires Material 1.5+
         so we keep it minimal here and set colors in XML directly
         ════════════════════════════════════════ -->

    <style name="BottomNav.Style" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/surface_white</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">16dp</item>
    </style>

</resources>