<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="32dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Session Active 🟢"
        android:textColor="#1A237E"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show this code to students. Expires in 15 minutes."
        android:textColor="#7986CB"
        android:textSize="13sp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="20dp" />

    <!-- Big code display -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#1A237E"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvSessionCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AB3X7Y"
                android:textColor="#FFD54F"
                android:textSize="52sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.3" />

            <TextView
                android:id="@+id/tvSessionDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9FA8DA"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvSessionExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#EF9A9A"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Stop session button -->
    <TextView
        android:id="@+id/btnStopSession"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="Stop Session"
        android:textColor="#FFCDD2"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_logout"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
