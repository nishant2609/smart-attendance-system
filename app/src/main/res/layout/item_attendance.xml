<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Avatar circle -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar_circle"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvAttendanceInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="A"
                android:textColor="#1A237E"
                android:textSize="17sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- Name + SRN -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A237E" />

            <TextView
                android:id="@+id/tvStudentSrn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#7986CB"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- P / A toggle buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_pa_track"
            android:padding="3dp">

            <Button
                android:id="@+id/btnPresent"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:text="P"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_p_unselected"
                android:padding="0dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnAbsent"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:text="A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_a_unselected"
                android:padding="0dp"
                android:layout_marginStart="2dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>