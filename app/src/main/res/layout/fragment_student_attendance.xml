<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2FF">

    <!-- ══════════════════════════════════════ -->
    <!--            GRADIENT HEADER             -->
    <!-- ══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_admin_header"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Attendance"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subject-wise breakdown"
            android:textColor="#9FA8DA"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- ── DATE ROW inside header ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_spinner_on_dark"
            android:paddingLeft="14dp"
            android:paddingRight="8dp"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:hint="All time"
                android:textColorHint="#9FA8DA" />

            <ImageButton
                android:id="@+id/btnPickDate"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_nav_attendance"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFD54F"
                android:contentDescription="Pick date"
                android:padding="10dp"
                android:minWidth="48dp"
                android:minHeight="48dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ══════════════════════════════════════ -->
    <!--         SUBJECT ATTENDANCE LIST        -->
    <!-- ══════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSubjectAttendance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false" />

</LinearLayout>